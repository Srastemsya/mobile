{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow"
    },
    "external_directory": "ask"
  },
  "mcp": {
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "oauth": {}
    }
  },
  "provider": {
    "compatible": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Custom OpenAI-compatible",
      "options": {
        "baseURL": "{env:COMPAT_API_BASE}",
        "apiKey": "{env:COMPAT_API_KEY}"
      }
    }
  }
}
