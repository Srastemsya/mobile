#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
bin="${OPENCODE_BIN:-$PWD/.opencode/bin/opencode}"
if [ ! -x "$bin" ]; then
  echo "OpenCode 1.x не найден: $bin." >&2
  exit 1
fi
state="${OPENCODE_STATE_ROOT:-$PWD/.opencode/state/v1}"
export XDG_CONFIG_HOME="$state/config"
export XDG_DATA_HOME="$state/data"
export XDG_CACHE_HOME="$state/cache"
export XDG_STATE_HOME="$state/state"
export OPENCODE_DISABLE_PROJECT_CONFIG=1
case "${1:-}" in
  --version|--help) exec "$bin" "$@" ;;
  mcp)
    OPENCODE_CONFIG_CONTENT='{"mcp":{"figma":{"type":"remote","url":"https://mcp.figma.com/mcp"}}}'
    export OPENCODE_CONFIG_CONTENT
    exec "$bin" "$@"
    ;;
esac
: "${COMPAT_API_BASE:?Укажите базовый URL API}"
: "${COMPAT_API_KEY:?Загрузите ключ API в окружение}"
: "${COMPAT_API_MODEL:?Укажите точный ID модели}"
python_bin="${PYTHON_BIN:-}"
if [ -z "$python_bin" ]; then
  if [ -x /usr/bin/python3 ]; then
    python_bin=/usr/bin/python3
  else
    python_bin="$(command -v python3)" || { echo 'Python 3 не найден.' >&2; exit 1; }
  fi
fi
OPENCODE_CONFIG_CONTENT="$("$python_bin" - <<'PY'
import json
import os

model = os.environ["COMPAT_API_MODEL"]
print(json.dumps({
    "model": f"compatible/{model}",
    "provider": {
        "compatible": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Custom OpenAI-compatible",
            "options": {
                "baseURL": os.environ["COMPAT_API_BASE"],
                "apiKey": os.environ["COMPAT_API_KEY"],
            },
            "models": {model: {"name": model}},
        }
    },
    "mcp": {
        "figma": {"type": "remote", "url": "https://mcp.figma.com/mcp"}
    },
}))
PY
)"
export OPENCODE_CONFIG_CONTENT
exec "$bin" "$@"
