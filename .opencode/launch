#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
bin="${OPENCODE_BIN:-$PWD/.opencode/bin/opencode}"
if [ ! -x "$bin" ]; then
  bin="$(command -v opencode)" || { echo 'OpenCode CLI отсутствует. См. README.opencode.md.' >&2; exit 1; }
fi
state="$PWD/.opencode/state"
export XDG_CONFIG_HOME="$state/config"
export XDG_DATA_HOME="$state/data"
export XDG_CACHE_HOME="$state/cache"
export XDG_STATE_HOME="$state/state"
case "${1:-}" in
  --version|--help|mcp) exec "$bin" "$@" ;;
esac
: "${COMPAT_API_BASE:?Укажите базовый URL API}"
: "${COMPAT_API_KEY:?Загрузите ключ API в окружение}"
: "${COMPAT_API_MODEL:?Укажите точный ID модели}"
OPENCODE_CONFIG_CONTENT="$(python3 - <<'PY'
import json
import os

model = os.environ["COMPAT_API_MODEL"]
print(json.dumps({
    "model": f"compatible/{model}",
    "provider": {
        "compatible": {
            "models": {model: {"name": model}},
        }
    },
}))
PY
)"
export OPENCODE_CONFIG_CONTENT
exec "$bin" "$@"
